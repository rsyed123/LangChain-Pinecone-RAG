# Existing keys (unchanged)
PINECONE_API_KEY=...
OPENAI_API_KEY=...
PINECONE_INDEX_NAME=langchain-sample-index

# Google OAuth — copy from Google Cloud Console
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...

# Must match the redirect URI registered in Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# Any long random string, used to sign session cookies
COOKIE_SECRET=change-me-to-a-long-random-string

# Where to send users after login/logout
FRONTEND_URL=http://localhost:5173
